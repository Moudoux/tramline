[Unit]
Description=Tramline print server
After=network-online.target
Wants=network-online.target

[Service]
User=tramline
Group=tramline
SupplementaryGroups=dialout
ExecStart=/usr/local/bin/tramline serve
Restart=always
RestartSec=5

# Only what it needs: the serial port, its data directory and the network.
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/var/lib/tramline
ProtectHome=true
PrivateTmp=true
DevicePolicy=closed
DeviceAllow=char-ttyUSB rw
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
# AF_NETLINK is how Go looks up an interface's addresses, for listen_interfaces.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
